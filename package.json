{
  "name": "ilmek",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test && pnpm test:contracts",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "pnpm -r typecheck",
    "demo:local": "pnpm --filter @ilmek/scripts demo:local",
    "abi": "cd contracts && forge build -q && forge inspect FiberLedger abi --json > ../packages/core/src/FiberLedger.abi.json",
    "demo:base": "pnpm --filter @ilmek/scripts demo:base",
    "fund": "pnpm --filter @ilmek/scripts fund"
  }
}
